.DS_Store
node_modules/
*.log
.env

# Generated by scripts/build.mjs. Nothing here is edited by hand.
public/
export/
lukotta-translations.zip

# Review returned by an outside reviewer. Read, acted on, and kept out of
# the repository — it is working material, not part of the site.
translation-review/

translation-delta.md
export-delta/

# Written by an auditing agent on request. A working note, not part of the site.
audit.md

# Working files for the translation harnesses. Regenerated on demand.
dist/

# Launch configuration for the agent's preview pane. Local scaffolding for
# `npm start`, not part of the site.
# Contents, not the directory: git will not re-include anything inside an
# excluded directory, so `.claude/` followed by a negation silently ignores
# the negation.
.claude/*
# The project halves of the role briefs are the exception. They are project
# knowledge - this project's commands, paths and hard-won facts - and a role
# reads them from a fresh clone, so they belong in the repository.
!.claude/roles/
